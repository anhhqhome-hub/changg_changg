# Local development:
DATABASE_URL="file:./prisma/dev.db"
DATABASE_AUTH_TOKEN=""

# Vercel production MUST use a persistent shared database for CRUD/import.
# You may either replace DATABASE_URL/DATABASE_AUTH_TOKEN with libSQL values,
# or set these Turso aliases (they take precedence when present):
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""
BETTER_AUTH_SECRET="replace-with-at-least-32-characters"
BETTER_AUTH_URL="http://localhost:3000"
SEED_ADMIN_NAME="Admin trangg"
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_TEACHER_USERNAME="trang.teacher"
SEED_TEACHER_PASSWORD="ChangeMe123!"
SEED_STUDENT_PASSWORD="ChangeMe123!"
UPLOAD_DIR="./storage/uploads"
MAX_UPLOAD_MB="25"
APP_TIMEZONE="Asia/Ho_Chi_Minh"
DEFAULT_LOCALE="vi"

# Optional AI assistant / exam review
GROQ_API_KEY=""
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_AI_MODEL="openai/gpt-oss-120b"
